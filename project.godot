; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="FriendshipHouseTycoon"
run/main_scene="uid://du3of3w2rc627"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="uid://50a8kaq5wchw"
config/windows_native_icon="res://icon.ico"

[autoload]

ErrorManager="*res://autoload/ErrorManager.gd"
SoundManager="*res://autoload/SoundManager.gd"
EconomyManager="*res://autoload/EconomyManager.gd"
IncomeManager="*res://autoload/IncomeManager.gd"
PrestigeManager="*res://autoload/PrestigeManager.gd"
ButtonManager="*res://autoload/ButtonManager.gd"
TooltipManager="*res://autoload/TooltipManager.gd"
RightPanelManager="*res://autoload/RightPanelManager.gd"
EventManager="*res://autoload/EventManager.gd"
SaveManager="*res://autoload/SaveManager.gd"

[display]

window/stretch/aspect="expand"
window/stretch/mode.mobile="canvas_items"

[gui]

theme/default_font_multichannel_signed_distance_field=true

[physics]

