[gd_scene format=3]

[ext_resource type="Script" path="res://ui/developer_tools.gd" id="1_tools"]

[node name="DeveloperTools" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1
script = ExtResource("1_tools")

[node name="Backdrop" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.55)

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -230.0
offset_top = -250.0
offset_right = 230.0
offset_bottom = 250.0
grow_horizontal = 2
grow_vertical = 2

[node name="MarginContainer" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 18
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 18

[node name="VBoxContainer" type="VBoxContainer" parent="Panel/MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Panel/MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "개발자 도구"
horizontal_alignment = 1

[node name="Description" type="Label" parent="Panel/MarginContainer/VBoxContainer"]
layout_mode = 2
text = "추가할 자금 입력"
horizontal_alignment = 1

[node name="AmountInput" type="LineEdit" parent="Panel/MarginContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
placeholder_text = "예: 1000000"
alignment = 1
select_all_on_focus = true

[node name="MultiplierSeparator" type="HSeparator" parent="Panel/MarginContainer/VBoxContainer"]
layout_mode = 2

[node name="TimeMultiplierRow" type="HBoxContainer" parent="Panel/MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TimeMultiplierLabel" type="Label" parent="Panel/MarginContainer/VBoxContainer/TimeMultiplierRow"]
custom_minimum_size = Vector2(150, 0)
layout_mode = 2
text = "개발자 시간 배율"

[node name="TimeMultiplierInput" type="LineEdit" parent="Panel/MarginContainer/VBoxContainer/TimeMultiplierRow"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
size_flags_horizontal = 3
text = "1"
alignment = 1
select_all_on_focus = true

[node name="IncomeMultiplierRow" type="HBoxContainer" parent="Panel/MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="IncomeMultiplierLabel" type="Label" parent="Panel/MarginContainer/VBoxContainer/IncomeMultiplierRow"]
custom_minimum_size = Vector2(150, 0)
layout_mode = 2
text = "개발자 수입 배율"

[node name="IncomeMultiplierInput" type="LineEdit" parent="Panel/MarginContainer/VBoxContainer/IncomeMultiplierRow"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
size_flags_horizontal = 3
text = "1"
alignment = 1
select_all_on_focus = true

[node name="MultiplierHelp" type="Label" parent="Panel/MarginContainer/VBoxContainer"]
layout_mode = 2
text = "기존 전역 배율 × 개발자 배율로 적용\n시간 배율 2 = 기존 생산 속도의 2배"
horizontal_alignment = 1

[node name="ApplyMultipliersButton" type="Button" parent="Panel/MarginContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
text = "배율 적용"

[node name="StatusLabel" type="Label" parent="Panel/MarginContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
text = ""
horizontal_alignment = 1
autowrap_mode = 3

[node name="Buttons" type="HBoxContainer" parent="Panel/MarginContainer/VBoxContainer"]
