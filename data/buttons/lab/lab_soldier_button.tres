unlock_condition = ExtResource("2_condition")
show_world_purchase_button = true
click_dialogues = PackedStringArray("월급은 똑같지만 꿀보직입니다", "부식 서버 점검 중입니다", "부식 에너지(busik energy)는 저희 연구소가 세계최초입니다", "저 비취인가 없는데 여기서 일해도 됩니까?", "이곳의 모든 것은 국가 비밀입니다", "부식의 효율적인 생산과 짬역학을 연구합니다", "짬역학 제1법칙: 짬은 찰수록 좋다", "짬역학 제2법칙: 짬트로피는 항상 증가한다", "부식 서버는 부식 에너지원으로 작동합니다", "연구소의 온도와 습도를 유지해야 합니다", "아래층에서 자꾸 습기가 올라옵니다...", "이 층의 벽은 전부 특수 강화 콘크리트 재질입니다", "짬을 부식으로 바꿀 수만 있다면 무한동력입니다", "저는 중졸이고 여기서 최고학력입니다", "이거 기계 호스로 청소해도 됩니까? 에이 모르겠다", "저희는 세계최초로 부식 복제에 성공할 겁니다")
effect_type = 3
effect_target = "lab"
effect_value = 2.0
